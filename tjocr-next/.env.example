# ==============================================================================
# TJOCR Next — Environment Configuration Template
# ==============================================================================
# Скопируйте этот файл в .env.local и заполните ваши значения.
# НЕ коммитьте .env.local в систему контроля версий!

# ------------------------------------------------------------------------------
# Supabase Configuration (Auth, Postgres, Private Storage)
# ------------------------------------------------------------------------------
# Публичный URL вашего Supabase проекта (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Публичный анонимный ключ (Settings -> API -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Приватный ключ Supabase (Settings -> API Keys -> secret key).
# ВНИМАНИЕ: Используется ТОЛЬКО на сервере в Serverless/Edge функциях. Никогда не передавайте клиенту!
SUPABASE_SECRET_KEY=sb_secret_your-server-only-key
# Для legacy проекта также поддерживается, но новый secret key предпочтительнее:
# SUPABASE_SERVICE_ROLE_KEY=your-legacy-service-role-key

# Имя приватного Storage Bucket для документов и ассетов
SUPABASE_STORAGE_BUCKET=htr-uploads

# Upload, retention and account guardrails
MAX_UPLOAD_BYTES=10485760
ANONYMOUS_DOCUMENT_TTL_DAYS=7
AUTHENTICATED_DOCUMENT_TTL_DAYS=0
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_RATE_LIMIT_PER_MINUTE=8
ANONYMOUS_RATE_LIMIT_PER_MINUTE=20
DOCUMENT_RATE_LIMIT_PER_MINUTE=20

# Vercel Cron -> /api/v1/maintenance/cleanup (server-only, >= 16 chars)
CRON_SECRET=replace-with-a-long-random-secret

# ------------------------------------------------------------------------------
# External OCR / Line Detector Providers (Neutral Architecture)
# ------------------------------------------------------------------------------
# Базовый URL внешнего провайдера распознавания
OCR_API_BASE_URL=https://openrouter.ai/api/v1

# API-ключ к внешнему сервису (серверная переменная)
OCR_API_KEY=your-ocr-api-key

# Идентификатор модели распознавания (техническое имя модели у провайдера)
# Должен быть действительным для API провайдера, но никогда не раскрывается клиенту
OCR_MODEL_ID=your-provider-model-id

# Optional explicit recognizer model. If absent, OCR_MODEL_ID is used.
RECOGNIZER_MODEL_ID=your-provider-model-id

# Send four cropped lines in one provider request and keep at most two requests
# active in parallel. Their combined result is saved with one bulk upsert, so
# progress advances honestly by eight lines without per-line database writes.
RECOGNITION_BATCH_SIZE=4
RECOGNITION_BATCH_CONCURRENCY=2
OCR_REQUEST_TIMEOUT_MS=20000
OCR_MAX_OUTPUT_TOKENS=1024
OCR_REASONING_EFFORT=low

# OpenRouter chooses a fast endpoint for interactive OCR and de-prioritises
# routes with poor five-minute latency/throughput measurements.
OPENROUTER_OCR_PROVIDER=google-ai-studio/flex
OPENROUTER_PREFERRED_MAX_LATENCY_SECONDS=5
OPENROUTER_PREFERRED_MIN_THROUGHPUT=60

# Идентификатор или эндпоинт детектора строк
DETECTOR_MODEL_ID=your-detector-model-id

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
# Базовый адрес приложения для редиректов авторизации и ссылок
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Режим окружения (development, test, production)
NODE_ENV=development
